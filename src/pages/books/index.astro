---
import Base from '../../layouts/Base.astro';
import MediaCard from '../../components/MediaCard.astro';
import { getPublished, toCard } from '../../lib/media';

const entries = await getPublished('books');
const cards = entries
  .map((e) => toCard('books', e))
  .sort((a, b) => b.date.getTime() - a.date.getTime());
---

<Base title="책 — 감상 기록">
  <section class="hero">
    <h1 data-hero-title><span class="hero-line"><span class="hero-line-inner">책<em>.</em></span></span></h1>
    <p class="hero-sub">읽은 책과 그 언저리의 생각.</p>
  </section>
  <div class="media-grid">
    {cards.map((card, i) => <MediaCard card={card} index={i} />)}
  </div>
</Base>
