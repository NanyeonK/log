---
import Base from '../layouts/Base.astro';
import MediaCard from '../components/MediaCard.astro';
import { getAllCards } from '../lib/media';

const cards = await getAllCards();
const latest = cards.slice(0, 12);
---

<Base>
  <section class="hero">
    <h1 data-hero-title>
      <span class="hero-line"><span class="hero-line-inner">듣고, 보고,</span></span>
      <span class="hero-line"><span class="hero-line-inner">읽은 것들<em>.</em></span></span>
    </h1>
    <p class="hero-sub">생각과 감상의 기록. 최근 글부터.</p>
  </section>

  <div class="section-head">
    <h2 class="reveal">최근 기록</h2>
  </div>
  <div class="media-grid">
    {latest.map((card, i) => <MediaCard card={card} index={i} />)}
  </div>
</Base>
