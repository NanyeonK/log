---
import Base from '../../layouts/Base.astro';
import MediaCard from '../../components/MediaCard.astro';
import { getPublished, toCard } from '../../lib/media';

const entries = await getPublished('music');
const cards = entries
  .map((e) => toCard('music', e))
  .sort((a, b) => b.date.getTime() - a.date.getTime());
---

<Base title="음악 — 감상 기록">
  <section class="hero">
    <h1 data-hero-title><span class="hero-line"><span class="hero-line-inner">음악<em>.</em></span></span></h1>
    <p class="hero-sub">앨범 단위로 남기는 리스닝 로그.</p>
  </section>
  <div class="media-grid">
    {cards.map((card, i) => <MediaCard card={card} index={i} />)}
  </div>
</Base>
