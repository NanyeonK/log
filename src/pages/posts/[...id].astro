---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntryHero from '../../components/EntryHero.astro';
import { getPublished, toCard } from '../../lib/media';
export async function getStaticPaths() {
  return (await getPublished()).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const card = toCard(entry);
const d = entry.data;
const facts: Array<[string, string]> = [];
if (d.publisher) facts.push(['출판사', d.publisher]);
if (d.pages) facts.push(['쪽수', `${d.pages}p`]);
if (d.label) facts.push(['레이블', d.label]);
if (d.cast?.length) facts.push(['출연', d.cast.join(', ')]);
if (d.genre.length) facts.push(['장르', d.genre.join(', ')]);
if (d.rating != null) facts.push(['평점', `${d.rating} / 10`]);
facts.push(['날짜', d.date.toISOString().slice(0, 10)]);
---
<Base title={`${d.title} — 기록`}><EntryHero card={card} facts={facts} /><article class="prose reveal"><Content /></article></Base>
