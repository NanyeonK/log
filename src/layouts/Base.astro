---
import { ClientRouter } from 'astro:transitions';
import { withBase } from '../lib/url';
import { getCategories, categoryLabel, categorySlug } from '../lib/media';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = '듣고, 보고, 읽은 것들', description = '연찬의 기록' } = Astro.props;
const nav = (await getCategories()).map((category) => ({
  href: withBase(`/categories/${categorySlug(category)}/`), label: categoryLabel(category),
}));
const current = Astro.url.pathname;
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      // 다크모드 + js 플래그: FOUC 방지 위해 inline. View Transitions 스왑 후에도 재적용.
      (function () {
        const apply = () => {
          const saved = localStorage.getItem('theme');
          const theme =
            saved ?? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;
          document.documentElement.classList.add('js');
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href={withBase('/')}>듣다<span>·</span>보다<span>·</span>읽다</a>
        <nav class="site-nav">
          {nav.map((item) => (
            <a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
          <button id="theme-toggle" aria-label="다크모드 전환">
            <span class="moon">☾</span><span class="sun">☀</span>
          </button>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">© {new Date().getFullYear()} Yeonchan — 기록</div>
    </footer>

    <script>
      import { initMotion, destroyMotion } from '../scripts/motion';

      function initThemeToggle() {
        document.getElementById('theme-toggle')?.addEventListener('click', () => {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          localStorage.setItem('theme', next);
        });
      }

      document.addEventListener('astro:page-load', () => {
        initThemeToggle();
        initMotion();
      });
      // View Transitions 스왑 직전: 이전 페이지의 ScrollTrigger/리스너 정리
      document.addEventListener('astro:before-swap', () => {
        destroyMotion();
      });
    </script>
  </body>
</html>
